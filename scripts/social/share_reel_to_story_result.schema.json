{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "page",
    "reel_match",
    "story_share",
    "verification",
    "details",
    "evidence"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["shared", "already_shared", "failed", "skipped"]
    },
    "page": { "type": "string" },
    "reel_match": { "type": "boolean" },
    "story_share": { "type": "boolean" },
    "verification": { "type": "boolean" },
    "details": { "type": "string" },
    "evidence": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
