{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-agent.local/contracts/ui-response.v1.1.schema.json",
  "title": "AgentUIResponseV1.1",
  "description": "Respuesta UI declarativa y segura. Amplía 1.0 con métricas, gráficas, cronologías, avisos y enlaces tipados; no admite HTML o JavaScript arbitrario.",
  "$defs": {
    "typedLinkTarget": {
      "type": "object",
      "required": ["kind", "value"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["internal_route", "domain_app", "external_url"]
        },
        "value": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {
            "properties": {"kind": {"const": "internal_route"}},
            "required": ["kind"]
          },
          "then": {"properties": {"value": {"pattern": "^[A-Za-z0-9_-]+$"}}}
        },
        {
          "if": {
            "properties": {"kind": {"const": "domain_app"}},
            "required": ["kind"]
          },
          "then": {
            "properties": {"value": {"pattern": "^(?:personal-agent|granja-luna):"}}
          }
        },
        {
          "if": {
            "properties": {"kind": {"const": "external_url"}},
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "value": {
                "allOf": [
                  {"pattern": "^https?:"},
                  {"not": {"pattern": "^https?://[^/]*@"}}
                ]
              }
            }
          }
        }
      ],
      "additionalProperties": true
    },
    "legacyLinkValue": {
      "type": "string",
      "minLength": 1,
      "anyOf": [
        {
          "allOf": [
            {"pattern": "^https?:"},
            {"not": {"pattern": "^https?://[^/]*@"}}
          ]
        },
        {"pattern": "^(?:personal-agent|granja-luna):"},
        {"pattern": "^[/#]"}
      ]
    },
    "linkItem": {
      "type": "object",
      "required": ["label"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "target": {"$ref": "#/$defs/typedLinkTarget"},
        "url": {"$ref": "#/$defs/legacyLinkValue"},
        "href": {"$ref": "#/$defs/legacyLinkValue"},
        "app_url": {"$ref": "#/$defs/legacyLinkValue"}
      },
      "anyOf": [
        {"required": ["target"]},
        {"required": ["url"]},
        {"required": ["href"]},
        {"required": ["app_url"]}
      ],
      "additionalProperties": true
    }
  },
  "type": "object",
  "required": ["schema_version", "response_type", "title", "summary", "risk_level", "requires_confirmation", "rendering_mode", "components", "information_status"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.1"},
    "response_type": {"type": "string", "enum": ["message", "review", "confirmation", "form", "report"]},
    "title": {"type": "string"},
    "summary": {"type": "string"},
    "risk_level": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
    "requires_confirmation": {"type": "boolean"},
    "rendering_mode": {"type": "string", "enum": ["host_native", "domain_component", "external_view"]},
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["component", "props"],
        "properties": {
          "component": {
            "type": "string",
            "enum": ["summary_card", "data_table", "checklist", "field_group", "action_group", "metric_grid", "chart", "bar_chart", "timeline", "link_group", "notice"]
          },
          "props": {
            "type": "object",
            "description": "Datos declarativos interpretados por el renderer del host. Nunca HTML, CSS o JavaScript ejecutable.",
            "maxProperties": 32,
            "additionalProperties": true
          }
        },
        "allOf": [
          {
            "if": {"properties": {"component": {"const": "data_table"}}},
            "then": {"properties": {"props": {"properties": {"rows": {"type": "array", "maxItems": 100, "items": {"type": "object"}}}}}}
          },
          {
            "if": {"properties": {"component": {"const": "checklist"}}},
            "then": {"properties": {"props": {"properties": {"items": {"type": "array", "maxItems": 50}}}}}
          },
          {
            "if": {"properties": {"component": {"const": "action_group"}}},
            "then": {"properties": {"props": {"properties": {"actions": {"type": "array", "maxItems": 20, "items": {"type": "object", "required": ["id", "label"], "properties": {"id": {"type": "string", "minLength": 1}, "label": {"type": "string", "minLength": 1}}}}}}}}
          },
          {
            "if": {"properties": {"component": {"const": "timeline"}}},
            "then": {"properties": {"props": {"properties": {"items": {"type": "array", "maxItems": 50}}}}}
          },
          {
            "if": {"properties": {"component": {"const": "link_group"}}},
            "then": {"properties": {"props": {"properties": {"links": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/linkItem"}}}}}}
          }
        ],
        "additionalProperties": false
      }
    },
    "information_status": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "enum": ["confirmed", "inferred", "pending_review", "draft", "legacy"]}
    }
  },
  "allOf": [
    {
      "if": {"required": ["risk_level"], "properties": {"risk_level": {"enum": ["medium", "high", "critical"]}}},
      "then": {"properties": {"requires_confirmation": {"const": true}}}
    }
  ],
  "additionalProperties": false
}
