{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-agent.local/contracts/ui-response.v1.schema.json",
  "title": "AgentUIResponseV1",
  "description": "Contrato semántico compartido entre agentes de dominio y aplicaciones host.",
  "type": "object",
  "required": [
    "schema_version",
    "response_type",
    "title",
    "summary",
    "risk_level",
    "requires_confirmation",
    "rendering_mode",
    "components",
    "information_status"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "response_type": {
      "type": "string",
      "enum": ["message", "review", "confirmation", "form", "report"]
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "risk_level": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "requires_confirmation": {
      "type": "boolean"
    },
    "rendering_mode": {
      "type": "string",
      "enum": ["host_native", "domain_component", "external_view"]
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["component", "props"],
        "properties": {
          "component": {
            "type": "string",
            "enum": [
              "summary_card",
              "data_table",
              "checklist",
              "field_group",
              "action_group"
            ]
          },
          "props": {
            "type": "object",
            "maxProperties": 32,
            "additionalProperties": true
          }
        },
        "allOf": [
          {
            "if": {"properties": {"component": {"const": "data_table"}}},
            "then": {
              "properties": {
                "props": {
                  "properties": {
                    "rows": {
                      "type": "array",
                      "maxItems": 100,
                      "items": {"type": "object"}
                    }
                  }
                }
              }
            }
          },
          {
            "if": {"properties": {"component": {"const": "checklist"}}},
            "then": {
              "properties": {
                "props": {
                  "properties": {
                    "items": {"type": "array", "maxItems": 50}
                  }
                }
              }
            }
          },
          {
            "if": {"properties": {"component": {"const": "action_group"}}},
            "then": {
              "properties": {
                "props": {
                  "properties": {
                    "actions": {
                      "type": "array",
                      "maxItems": 20,
                      "items": {
                        "type": "object",
                        "required": ["id", "label"],
                        "properties": {
                          "id": {"type": "string", "minLength": 1},
                          "label": {"type": "string", "minLength": 1}
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "information_status": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "enum": ["confirmed", "inferred", "pending_review", "draft", "legacy"]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["risk_level"],
        "properties": {
          "risk_level": {
            "enum": ["medium", "high", "critical"]
          }
        }
      },
      "then": {
        "properties": {
          "requires_confirmation": {
            "const": true
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
